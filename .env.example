# Infobip trial SMS connectivity test and development reminder worker
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=
INFOBIP_TEST_RECIPIENT=
INFOBIP_ALLOW_TEST_SEND=false
REMINDER_ADMIN_SECRET=
REMINDER_WORKER_ALLOW_SEND=false
INFOBIP_WEBHOOK_USERNAME=
INFOBIP_WEBHOOK_PASSWORD=
INFOBIP_WEBHOOK_TEST_URL=
SMS_REMINDERS_RUNTIME_ENABLED=false
REMINDER_CRON_SECRET=
REMINDER_CRON_BATCH_SIZE=5

# SMS confirmation of public bookings (pilot). Off unless explicitly enabled, and also per salon
# (salons.booking_confirmation_sms_enabled). Only exact numbers on the comma-separated team list receive it,
# unless BOOKING_CONFIRMATION_SMS_RECIPIENT_MODE=any (every valid number, still per salon and within the limits).
# Unset/empty or "allowlist" keeps the list; any other value sends nothing.
# The hash key (32+ chars, secret) is used for the phone-number digest behind the limits.
BOOKING_CONFIRMATION_SMS_ENABLED=false
BOOKING_CONFIRMATION_SMS_RECIPIENT_MODE=allowlist
BOOKING_CONFIRMATION_SMS_ALLOWED_RECIPIENTS=
BOOKING_CONFIRMATION_SMS_HASH_KEY=

# Public booking protection: Cloudflare Turnstile (validated on the server) and a per-IP limit of new attempts
# (10 per 10 minutes, 40 per 24 hours). Off unless enabled; when enabled every value below is required, otherwise
# new public bookings are refused (fail closed). TURNSTILE_ALLOWED_HOSTNAMES is a comma-separated list of the
# hostnames Turnstile must report. The rate-limit hash key (32+ chars, secret) is used for the IP digest.
PUBLIC_BOOKING_PROTECTION_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
PUBLIC_BOOKING_RATE_LIMIT_HASH_KEY=
# Local tests only (ignored on Vercel and in production builds):
# TURNSTILE_VERIFY_URL=http://127.0.0.1:3444/siteverify
# PUBLIC_BOOKING_TRUST_TEST_IP_HEADER=true
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false
# Preview/test uses the test flag. Production/live uses the separate live flag
# and requires a server-side pilot salon allowlist. There is no flag fallback.
BILLING_CHECKOUT_ENABLED=false
BILLING_LIVE_CHECKOUT_ENABLED=false
BILLING_LIVE_CHECKOUT_ALLOWED_SALON_IDS=
# Per-deployment billing authority: Preview=test, Production=live
BILLING_PROVIDER=
BILLING_ENVIRONMENT=
# Test credentials belong to Preview/test deployments; live credentials belong
# only to Production/live deployments. No fallback exists between environments.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_LIVE_API_KEY=
LEMONSQUEEZY_LIVE_STORE_ID=
BILLING_WEBHOOKS_ENABLED=false
LEMONSQUEEZY_WEBHOOK_SECRET=
BILLING_LIVE_WEBHOOKS_ENABLED=false
LEMONSQUEEZY_LIVE_WEBHOOK_SECRET=
BILLING_CUSTOMER_PORTAL_ENABLED=false
LEMONSQUEEZY_PORTAL_ALLOWED_HOSTS=
BILLING_WORKER_ENABLED=false
BILLING_WORKER_SECRET=
BILLING_WORKER_BATCH_SIZE=10
BILLING_LIVE_WORKER_ENABLED=false
BILLING_LIVE_WORKER_SECRET=
BILLING_LIVE_WORKER_BATCH_SIZE=5
# Manual checkout recovery is operator-only, disabled by default, and has no
# cross-environment secret or credential fallback.
BILLING_CHECKOUT_RECOVERY_ENABLED=false
BILLING_CHECKOUT_RECOVERY_SECRET=
BILLING_CHECKOUT_RECOVERY_LEASE_SECONDS=300
BILLING_CHECKOUT_RECOVERY_PAGE_SIZE=50
BILLING_CHECKOUT_RECOVERY_MAX_PAGES=5
BILLING_LIVE_CHECKOUT_RECOVERY_ENABLED=false
BILLING_LIVE_CHECKOUT_RECOVERY_SECRET=
BILLING_LIVE_CHECKOUT_RECOVERY_LEASE_SECONDS=300
BILLING_LIVE_CHECKOUT_RECOVERY_PAGE_SIZE=25
BILLING_LIVE_CHECKOUT_RECOVERY_MAX_PAGES=5
BILLING_RECONCILIATION_ENABLED=false
BILLING_RECONCILIATION_SECRET=
BILLING_RECONCILIATION_BATCH_SIZE=10
