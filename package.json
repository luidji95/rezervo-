  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:dry-run": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts dry-run",
