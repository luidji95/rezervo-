    "test:availability": "node --experimental-strip-types --test src/services/availabilitySlotCore.test.ts",
    "test:sms-provider": "node --experimental-strip-types --test src/features/reminders/providers/infobipSmsProviderCore.test.ts",
    "test:reminder-worker": "node --experimental-strip-types --test src/features/reminders/services/appointmentReminderTemplate.test.ts src/features/reminders/services/reminderWorkerCore.test.ts src/features/reminders/services/developmentReminderWorkerGuard.test.ts src/features/reminders/services/reminderClaimCore.test.ts src/features/reminders/services/reminderClaimSqlRegression.test.ts src/features/reminders/services/reminderWorkerDiagnostics.test.ts",
    "test:sms-delivery-webhook": "node --experimental-strip-types --test src/features/reminders/services/infobipDeliveryReportParser.test.ts src/features/reminders/services/infobipDeliveryReportCore.test.ts src/features/reminders/services/infobipWebhookHttp.test.ts",
    "test:reminder-settings": "node --experimental-strip-types --test src/features/reminders/services/reminderSettingsPolicy.test.ts",
    "test:reminder-cron-endpoint": "node --experimental-strip-types --test src/features/reminders/services/reminderCronEndpointCore.test.ts src/features/reminders/services/reminderCronSqlFoundation.test.ts",
    "test:infobip-sms": "node --env-file=.env.local scripts/test-infobip-sms.mjs",
    "test:infobip-webhook-smoke": "node --env-file=.env.local scripts/test-infobip-delivery-webhook.mjs",
    "seed:dry-run": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts dry-run",
    "seed:small": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts seed --profile small",
    "seed:medium": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts seed --profile medium",
    "seed:large": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts seed --profile large",
    "seed:cleanup": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts cleanup",
    "seed:validate": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts validate"
