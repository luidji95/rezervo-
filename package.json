    "seed:medium": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts seed --profile medium",
    "seed:large": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts seed --profile large",
    "seed:cleanup": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts cleanup",
    "seed:validate": "node --env-file-if-exists=.env.local tools/production-simulation/cli.ts validate"
  },
  "dependencies": {
